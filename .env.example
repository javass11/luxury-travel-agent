# Flask Configuration
FLASK_ENV=development
FLASK_APP=src.app
DEBUG=True

# Security (Required for production - change these!)
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-change-in-production

# Database (Default: SQLite - works out of the box)
# For local development (SQLite):
DATABASE_URL=sqlite:///luxury_travel.db

# For PostgreSQL on Heroku:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Heroku automatically sets this when you add the addon

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRES=86400  # 24 hours

# Optional: Amadeus Flight API (Get from https://developers.amadeus.com/)
# Leave blank to use demo data
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Optional: Booking.com Hotel API (Get from https://affiliates.booking.com/)
# Leave blank to use demo data
BOOKING_API_KEY=

# Optional: Seats.aero Award Availability (Get from https://seats.aero/)
# Leave blank to use demo data
SEATS_AERO_API_KEY=
SEATS_AERO_BASE_URL=https://seats.aero/partnerapi
SEATS_AERO_AVAILABILITY_PATH=/search

# Optional: Redis Caching (Improves performance)
# Default: In-memory cache (works without this)
# REDIS_URL=redis://localhost:6379/0
# For Heroku Redis addon, this is set automatically

# Optional: API Timeouts (seconds)
API_TIMEOUT=10

# Optional: Cache TTL (Time To Live in seconds)
CACHE_TTL=3600  # 1 hour
