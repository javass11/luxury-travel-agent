# Production Environment Configuration for Heroku
# DO NOT commit .env.production file - only commit this .env.production.example

# ============================================================================
# SECURITY (REQUIRED)
# ============================================================================
SECRET_KEY=your-secret-key-here-min-32-characters-recommended

# ============================================================================
# DATABASE (Heroku PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://user:password@host:port/dbname
# Automatically set by Heroku when adding PostgreSQL add-on

# ============================================================================
# DEBUG & CORS
# ============================================================================
DEBUG=false
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# ============================================================================
# API KEYS (Optional - fallback to demo mode if not set)
# ============================================================================
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
DUFFEL_ACCESS_TOKEN=
SEATS_AERO_API_KEY=
ANTHROPIC_API_KEY=

# ============================================================================
# EMAIL SERVICE (Optional)
# ============================================================================
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@luxurytravelagent.com

# ============================================================================
# REDIS (Optional - uses in-memory cache if not set)
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# HEROKU SPECIFIC
# ============================================================================
# Port is automatically set by Heroku
# App URL will be: https://your-app-name.herokuapp.com
